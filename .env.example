# SIGNAL environment. Copy to .env (never commit .env). There are NO LLM API keys: AI runs through the
# Claude Runner, i.e. your local Claude Code CLI login (`claude` → /login). See docs/DECISIONS.md ADR-001.

SIGNAL_MODE=live                 # live | mock (mock = offline, deterministic, no network)
SIGNAL_DATABASE_URL=postgresql+asyncpg://signal:signal@localhost:5442/signal
SIGNAL_REDIS_URL=redis://localhost:6390/0
SIGNAL_USE_REDIS_QUEUE=true
SIGNAL_SECRET_KEY=change-me-to-a-long-random-string
SIGNAL_ADMIN_EMAIL=srijoy@localhost
SIGNAL_ADMIN_PASSWORD=change-me-now
SIGNAL_TIMEZONE=Asia/Kolkata
SIGNAL_WEB_ORIGIN=http://localhost:3710
SIGNAL_COOKIE_SECURE=false       # true behind HTTPS

# Claude Runner (local Claude Code CLI, subscription login)
SIGNAL_CLAUDE_BIN=claude
SIGNAL_RUNNER_CONCURRENCY=2
SIGNAL_RUNNER_TIMEOUT_S=180

# Embeddings: mock | fastembed (local bge-small-en-v1.5; `uv sync --extra local-embeddings`)
SIGNAL_EMBEDDING_PROVIDER=fastembed

# Optional adapters — leave empty to keep them disabled
SIGNAL_TELEGRAM_BOT_TOKEN=
SIGNAL_TELEGRAM_CHAT_ID=
SIGNAL_SMTP_URL=                 # e.g. smtp://user:pass@smtp.example.com:587
SIGNAL_EMAIL_FROM=signal@localhost
SIGNAL_GITHUB_TOKEN=
SIGNAL_HASHNODE_TOKEN=
SIGNAL_REDDIT_CLIENT_ID=
SIGNAL_REDDIT_CLIENT_SECRET=
SIGNAL_PRODUCTHUNT_TOKEN=
SIGNAL_YOUTUBE_API_KEY=
SIGNAL_IMAP_URL=                 # imaps://user:pass@imap.example.com/INBOX for newsletters
SIGNAL_BACKUP_S3_URL=            # optional S3-compatible bucket for backups
